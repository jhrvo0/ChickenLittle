<?xml version="1.0" encoding="UTF-8"?>
<module moduleId="MotionPet_pot_ModuleID" fritzingVersion="1.0.0">
 <version>1</version>
 <author>MotionPet (gerado)</author>
 <title>Potenciometro rotativo 3 terminais</title>
 <label>POT</label>
 <date>2026-10-29</date>
 <tags><tag>pot</tag><tag>MotionPet</tag></tags>
 <properties><property name="family">MotionPet generic</property><property name="editor">hardware/fz_parts.py</property></properties>
 <taxonomy>MotionPet.generic</taxonomy>
 <description>Parte generica: Potenciometro rotativo 3 terminais. Ordem dos pinos: ['END_A', 'WIPER', 'END_B'].</description>
 <views>
  <iconView><layers image="icon/MotionPet_pot_icon.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/MotionPet_pot_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/MotionPet_pot_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/MotionPet_pot_pcb.svg"><layer layerId="copper0"/><layer layerId="copper1"/><layer layerId="silkscreen"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="END_A" type="male">
   <description>END_A</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="WIPER" type="male">
   <description>WIPER</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="END_B" type="male">
   <description>END_B</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
 </connectors>
</module>
